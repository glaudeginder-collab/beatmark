# BeatMark — Environment Variables
# Copy this file to .env.local for local development.

# ── Financial Modeling Prep (FMP) ────────────────────────────────────────────
# Price data provider for VWRL/VWCE ETF prices.
#
# How to get a free key:
#   1. Go to https://financialmodelingprep.com
#   2. Sign up for a free account (no credit card required)
#   3. Copy your API key from the dashboard
#
# Free tier: 250 requests/day — sufficient for MVP usage.
# Supported tickers: VWRL.L (LSE, GBP), VWCE.AS (Euronext Amsterdam, EUR)
#
# If this is not set, the app falls back to Yahoo Finance (works locally,
# not recommended for production — Yahoo is unofficial and may break).
FMP_API_KEY=YOUR_FMP_API_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for API responses.
# Defaults to http://localhost:5173,http://localhost:3000 if not set.
# CORS_ORIGINS=https://beatmark.vercel.app
